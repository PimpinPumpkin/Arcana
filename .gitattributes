# Default: text files normalized to LF in the repo.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe rejects them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix shell scripts must keep LF.
*.sh text eol=lf
gradlew text eol=lf

# Binary assets — don't try to diff or normalize.
*.jpg binary
*.png binary
*.webp binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
