<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. See backup_rules.xml for what is included and why. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="decks/" />
    </device-transfer>
</data-extraction-rules>
